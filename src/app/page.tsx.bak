"use client";

import { useEffect, useMemo, useState } from "react";
import Link from "next/link";
import {
  ArrowDownRight,
  ArrowUpRight,
  CalendarDays,
  Check,
  CircleAlert,
  Loader2,
  PiggyBank,
  Plus,
  Repeat,
  Wallet,
} from "lucide-react";
import {
  CartesianGrid,
  Line,
  LineChart,
  ResponsiveContainer,
  Tooltip,
  XAxis,
  YAxis,
} from "recharts";

type Recurring = {
  id: string;
  name: string;
  amount: number;
  type: "income" | "expense";
  day: number;
  category: string;
  active: boolean;
};

type DashboardData = {
  summary: {
    income: number;
    fixedExpenses: number;
    variableBudget: number;
    totalExpenses: number;
    savingsGoal: number;
    available: number;
    afterSavings: number;
    savingsRate: number;
    actualIncome?: number;
    actualExpenses?: number;
    actualSavings?: number;
  };
  recurring: Recurring[];
  history: {
    month: string;
    income: number;
    expenses: number;
    savings: number;
  }[];
};

const now = new Date();
const month = new Date(
  now.getFullYear(),
  now.getMonth(),
  1
).toISOString().slice(0, 7);

const euro = (value: number) =>
  new Intl.NumberFormat("it-IT", {
    style: "currency",
    currency: "EUR",
    maximumFractionDigits: 2,
  }).format(value);

const monthLabel = new Intl.DateTimeFormat("it-IT", {
  month: "long",
  year: "numeric",
}).format(new Date(month));

export default function DashboardPage() {
  const [data, setData] = useState<DashboardData | null>(null);
  const [actual, setActual] = useState({
    income: 0,
    expenses: 0,
    savings: 0,
  });
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  useEffect(() => {
    async function loadDashboard() {
      try {
        setLoading(true);

        const response = await fetch(`/api/dashboard?month=${month}`, {
          credentials: "include",
        });

        const result = await response.json();

        if (!response.ok) {
          throw new Error(
            result.error || "Impossibile caricare la dashboard."
          );
        }

        setData(result);

        const monthlyResponse = await fetch(
          `/api/monthly-plan?month=${month}`,
          {
            credentials: "include",
          }
        );

        if (monthlyResponse.ok) {
          const monthlyData = await monthlyResponse.json();

          setActual({
            income: Number(monthlyData.actual?.income) || 0,
            expenses: Number(monthlyData.actual?.expenses) || 0,
            savings: Number(monthlyData.actual?.savings) || 0,
          });
        }
      } catch (err) {
        setError(
          err instanceof Error
            ? err.message
            : "Errore durante il caricamento."
        );
      } finally {
        setLoading(false);
      }
    }

    loadDashboard();
  }, []);

  const upcoming = useMemo(() => {
    if (!data) return [];

    return data.recurring
      .filter((item) => item.type === "expense" && item.active)
      .sort((a, b) => a.day - b.day)
      .slice(0, 5);
  }, [data]);

  if (loading) {
    return (
      <main className="flex min-h-screen items-center justify-center bg-zinc-50 dark:bg-zinc-950">
        <div className="flex items-center gap-2 text-sm text-zinc-500">
          <Loader2 size={18} className="animate-spin" />
          Caricamento dashboard...
        </div>
      </main>
    );
  }

  if (error || !data) {
    return (
      <main className="flex min-h-screen items-center justify-center bg-zinc-50 px-6 dark:bg-zinc-950">
        <div className="rounded-2xl border border-red-200 bg-red-50 p-6 text-sm text-red-700 dark:border-red-900/50 dark:bg-red-950/20 dark:text-red-300">
          {error || "Dati non disponibili."}
        </div>
      </main>
    );
  }

  const { summary } = data;

  const totalPlanned =
    summary.fixedExpenses + summary.variableBudget;

  const budgetUsed =
    summary.income > 0
      ? Math.min((totalPlanned / summary.income) * 100, 100)
      : 0;

  const savingsPercentage =
    summary.income > 0
      ? Math.min((summary.savingsGoal / summary.income) * 100, 100)
      : 0;

  const availablePercentage =
    summary.income > 0
      ? Math.max(
          Math.min((summary.afterSavings / summary.income) * 100, 100),
          0
        )
      : 0;

  const actualDifferenceIncome = actual.income - summary.income;
  const actualDifferenceExpenses = actual.expenses - summary.totalExpenses;
  const actualDifferenceSavings = actual.savings - summary.savingsGoal;

  const actualSavingsRate =
    actual.income > 0
      ? (actual.savings / actual.income) * 100
      : 0;

  return (
    <main className="min-h-screen bg-zinc-50 dark:bg-zinc-950">
      <div className="mx-auto max-w-7xl px-5 py-7 sm:px-6 lg:px-10 lg:py-9">
        {/* Header */}
        <header className="mb-8">
          <div className="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <p className="text-sm font-medium text-zinc-500">
                Panoramica finanziaria
              </p>

              <h1 className="mt-1 text-3xl font-semibold tracking-tight text-zinc-950 dark:text-white">
                Dashboard
              </h1>

              <p className="mt-2 text-sm capitalize text-zinc-500">
                Piano finanziario di{" "}
                <span className="font-medium text-zinc-800 dark:text-zinc-300">
                  {monthLabel}
                </span>
              </p>
            </div>

            <Link
              href="/movimenti"
              className="inline-flex h-10 items-center justify-center gap-2 rounded-xl bg-zinc-950 px-4 text-sm font-medium text-white transition hover:bg-zinc-800 dark:bg-white dark:text-zinc-950 dark:hover:bg-zinc-200"
            >
              <Plus size={17} />
              Nuovo movimento
            </Link>
          </div>
        </header>

        {/* KPI */}
        <section className="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <SummaryCard
            label="Entrate previste"
            value={euro(summary.income)}
            icon={<ArrowUpRight size={19} />}
          />

          <SummaryCard
            label="Uscite pianificate"
            value={euro(summary.totalExpenses)}
            icon={<ArrowDownRight size={19} />}
          />

          <SummaryCard
            label="Risparmio obiettivo"
            value={euro(summary.savingsGoal)}
            icon={<PiggyBank size={19} />}
          />

          <SummaryCard
            label="Disponibile dopo il piano"
            value={euro(summary.afterSavings)}
            icon={<Wallet size={19} />}
            negative={summary.afterSavings < 0}
            emphasis
          />
        </section>

        {/* Stato del piano */}
        <section className="mt-6 rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <div className="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <h2 className="text-lg font-semibold">
                Stato del piano
              </h2>

              <p className="mt-1 text-sm text-zinc-500">
                Una lettura rapida di come stai distribuendo le entrate.
              </p>
            </div>

            <span className="text-sm font-medium text-zinc-500">
              {summary.savingsRate.toFixed(1)}% di risparmio
            </span>
          </div>

          <div className="mt-7 grid gap-6 lg:grid-cols-3">
            <StatusMetric
              label="Budget utilizzato"
              value={euro(totalPlanned)}
              detail={`${budgetUsed.toFixed(0)}% delle entrate`}
              percentage={budgetUsed}
            />

            <StatusMetric
              label="Obiettivo risparmio"
              value={euro(summary.savingsGoal)}
              detail={`${savingsPercentage.toFixed(0)}% delle entrate`}
              percentage={savingsPercentage}
            />

            <StatusMetric
              label="Dopo il risparmio"
              value={euro(summary.afterSavings)}
              detail={
                summary.afterSavings >= 0
                  ? "Margine ancora disponibile"
                  : "Piano oltre le entrate"
              }
              percentage={availablePercentage}
              negative={summary.afterSavings < 0}
            />
          </div>

          <div className="mt-7 grid gap-4 border-t border-zinc-100 pt-5 sm:grid-cols-3 dark:border-zinc-800">
            <MiniStat
              label="Spese fisse"
              value={euro(summary.fixedExpenses)}
            />

            <MiniStat
              label="Budget variabile"
              value={euro(summary.variableBudget)}
            />

            <MiniStat
              label="Risparmio"
              value={euro(summary.savingsGoal)}
            />
          </div>
        </section>

        {/* Situazione reale */}
        <section className="mt-6 rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
          <div className="flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <h2 className="text-lg font-semibold">
                Situazione reale
              </h2>

              <p className="mt-1 text-sm text-zinc-500">
                Confronto tra il piano e ciò che è realmente successo questo mese.
              </p>
            </div>

            <span className="text-sm font-medium text-zinc-500">
              {actualSavingsRate.toFixed(1)}% di risparmio effettivo
            </span>
          </div>

          <div className="mt-6 grid gap-4 md:grid-cols-3">
            <ActualCard
              label="Entrate"
              planned={summary.income}
              actual={actual.income}
              difference={actualDifferenceIncome}
              positiveWhenPositive
            />

            <ActualCard
              label="Uscite"
              planned={summary.totalExpenses}
              actual={actual.expenses}
              difference={actualDifferenceExpenses}
              positiveWhenPositive={false}
            />

            <ActualCard
              label="Risparmio"
              planned={summary.savingsGoal}
              actual={actual.savings}
              difference={actualDifferenceSavings}
              positiveWhenPositive
            />
          </div>

          <div className="mt-5 rounded-xl bg-zinc-50 p-4 dark:bg-zinc-800/60">
            <div className="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p className="text-sm font-medium">
                  Lettura del mese
                </p>

                <p className="mt-1 text-xs text-zinc-500">
                  Gli effettivi vengono calcolati automaticamente dai movimenti registrati.
                </p>
              </div>

              <Link
                href="/movimenti"
                className="mt-2 text-xs font-medium text-zinc-600 hover:text-zinc-950 sm:mt-0 dark:text-zinc-400 dark:hover:text-white"
              >
                Vai ai movimenti →
              </Link>
            </div>
          </div>
        </section>

        {/* Grafico + Ricorrenti */}
        <div className="mt-6 grid gap-6 xl:grid-cols-[1.55fr_1fr]">
          <section className="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
            <div className="mb-5 flex items-start justify-between gap-4">
              <h2 className="text-lg font-semibold">
                Andamento finanziario
              </h2>

              <p className="mt-1 text-sm text-zinc-500">
                Come si stanno muovendo le tue finanze nel tempo.
              </p>
            </div>

            <span className="hidden rounded-full bg-zinc-100 px-3 py-1 text-xs font-medium text-zinc-500 sm:block dark:bg-zinc-800">
              Storico
            </span>

            {data.history.length === 0 ? (
              <div className="flex h-72 items-center justify-center rounded-xl bg-zinc-50 text-sm text-zinc-500 dark:bg-zinc-800/50">
                Salva almeno un piano mensile per iniziare a costruire lo storico.
              </div>
            ) : (
              <div className="h-72 w-full">
                <ResponsiveContainer width="100%" height="100%">
                  <LineChart
                    data={data.history}
                    margin={{
                      top: 10,
                      right: 10,
                      left: 0,
                      bottom: 10,
                    }}
                  >
                    <CartesianGrid
                      strokeDasharray="3 3"
                      vertical={false}
                    />

                    <XAxis
                      dataKey="month"
                      tickFormatter={(value) =>
                        new Intl.DateTimeFormat("it-IT", {
                          month: "short",
                        }).format(new Date(String(value)))
                      }
                      tickMargin={10}
                      axisLine={false}
                      tickLine={false}
                    />

                    <YAxis
                      tickFormatter={(value) =>
                        new Intl.NumberFormat("it-IT", {
                          notation: "compact",
                          maximumFractionDigits: 1,
                        }).format(value) + " €"
                      }
                      tickMargin={8}
                      axisLine={false}
                      tickLine={false}
                      width={65}
                    />

                    <Tooltip
                      formatter={(value, name) => [
                        euro(Number(value)),
                        name === "income"
                          ? "Entrate"
                          : name === "expenses"
                          ? "Uscite"
                          : "Risparmio",
                      ]}
                      labelFormatter={(value) =>
                        new Intl.DateTimeFormat("it-IT", {
                          month: "long",
                          year: "numeric",
                        }).format(new Date(String(value)))
                      }
                    />

                    <Line
                      type="monotone"
                      dataKey="income"
                      name="income"
                      strokeWidth={2.5}
                      dot={{ r: 3 }}
                      activeDot={{ r: 5 }}
                    />

                    <Line
                      type="monotone"
                      dataKey="expenses"
                      name="expenses"
                      strokeWidth={2.5}
                      dot={{ r: 3 }}
                      activeDot={{ r: 5 }}
                    />

                    <Line
                      type="monotone"
                      dataKey="savings"
                      name="savings"
                      strokeWidth={2.5}
                      dot={{ r: 3 }}
                      activeDot={{ r: 5 }}
                    />
                  </LineChart>
                </ResponsiveContainer>
              </div>
            )}
          </section>

          <section className="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
            <div className="mb-6 flex items-start justify-between gap-4">
              <div className="flex items-center gap-3">
                <div className="rounded-xl bg-zinc-100 p-2 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
                  <CalendarDays size={18} />
                </div>

                <div>
                  <h2 className="text-lg font-semibold">
                    Prossimi addebiti
                  </h2>

                  <p className="text-sm text-zinc-500">
                    Le prossime uscite ricorrenti.
                  </p>
                </div>
              </div>

              <Link
                href="/ricorrenti"
                className="text-xs font-medium text-zinc-500 transition hover:text-zinc-950 dark:hover:text-white"
              >
                Vedi tutti
              </Link>
            </div>

            {upcoming.length === 0 ? (
              <div className="rounded-xl bg-zinc-50 p-5 text-sm text-zinc-500 dark:bg-zinc-800/60">
                Nessun addebito ricorrente.
              </div>
            ) : (
              <div className="space-y-3">
                {upcoming.map((item) => (
                  <div
                    key={item.id}
                    className="flex items-center justify-between rounded-xl border border-zinc-100 p-3.5 dark:border-zinc-800"
                  >
                    <div className="flex min-w-0 items-center gap-3">
                      <div className="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-zinc-100 text-xs font-semibold dark:bg-zinc-800">
                        {item.day}
                      </div>

                      <div className="min-w-0">
                        <p className="truncate text-sm font-medium">
                          {item.name}
                        </p>

                        <p className="truncate text-xs text-zinc-500">
                          {item.category}
                        </p>
                      </div>
                    </div>

                    <span className="ml-3 shrink-0 text-sm font-semibold">
                      {euro(Number(item.amount))}
                    </span>
                  </div>
                ))}
              </div>
            )}

            <Link
              href="/ricorrenti"
              className="mt-5 flex h-10 items-center justify-center gap-2 rounded-xl border border-zinc-200 text-sm font-medium transition hover:bg-zinc-50 dark:border-zinc-700 dark:hover:bg-zinc-800"
            >
              <Repeat size={16} />
              Gestisci ricorrenti
            </Link>
          </section>
        </div>

        {/* Stato finale */}
        <section
          className={`mt-6 rounded-2xl border p-6 ${
            summary.afterSavings < 0
              ? "border-red-200 bg-red-50 dark:border-red-900/50 dark:bg-red-950/20"
              : "border-emerald-200 bg-emerald-50/60 dark:border-emerald-900/40 dark:bg-emerald-950/10"
          }`}
        >
          <div className="flex items-start gap-4">
            {summary.afterSavings < 0 ? (
              <CircleAlert
                size={21}
                className="mt-0.5 shrink-0 text-red-500"
              />
            ) : (
              <Check
                size={21}
                className="mt-0.5 shrink-0 text-zinc-700 dark:text-zinc-300"
              />
            )}

            <div className="min-w-0">
              <h2 className="font-semibold">
                {summary.afterSavings < 0
                  ? "Il piano richiede attenzione"
                  : "Il piano è in equilibrio"}
              </h2>

              <p className="mt-1 text-sm text-zinc-500">
                {summary.afterSavings < 0
                  ? `Dopo spese e risparmio previsto il piano supera le entrate di ${euro(
                      Math.abs(summary.afterSavings)
                    )}.`
                  : `Dopo spese e risparmio previsto rimangono ${euro(
                      summary.afterSavings
                    )} disponibili.`}
              </p>
            </div>
          </div>
        </section>

        {/* Azioni rapide */}
        <section className="mt-6">
          <div className="mb-4">
            <h2 className="text-lg font-semibold">Azioni rapide</h2>
            <p className="mt-1 text-sm text-zinc-500">
              Le operazioni che utilizzerai più spesso.
            </p>
          </div>

          <div className="grid gap-3 sm:grid-cols-3">
            <QuickAction
              href="/movimenti"
              icon={<Plus size={18} />}
              title="Nuovo movimento"
              description="Registra un'entrata o un'uscita"
            />

            <QuickAction
              href="/piano-mensile"
              icon={<Wallet size={18} />}
              title="Piano mensile"
              description="Modifica budget e obiettivo"
            />

            <QuickAction
              href="/ricorrenti"
              icon={<Repeat size={18} />}
              title="Aggiungi ricorrente"
              description="Gestisci entrate e spese fisse"
            />
          </div>
        </section>
      </div>
    </main>
  );
}

function ActualCard({
  label,
  planned,
  actual,
  difference,
  positiveWhenPositive,
}: {
  label: string;
  planned: number;
  actual: number;
  difference: number;
  positiveWhenPositive: boolean;
}) {
  const isPositive = positiveWhenPositive
    ? difference >= 0
    : difference <= 0;

  return (
    <div className="rounded-2xl border border-zinc-200 bg-zinc-50 p-5 dark:border-zinc-800 dark:bg-zinc-950">
      <p className="text-sm font-medium text-zinc-500">
        {label}
      </p>

      <div className="mt-2 flex items-end justify-between gap-3">
        <div>
          <p className="text-2xl font-semibold tracking-tight text-zinc-950 dark:text-white">
            {euro(actual)}
          </p>

          <p className="mt-1 text-xs text-zinc-500">
            Piano: {euro(planned)}
          </p>
        </div>

        <span
          className={`text-xs font-semibold ${
            isPositive
              ? "text-emerald-600 dark:text-emerald-400"
              : "text-red-600 dark:text-red-400"
          }`}
        >
          {difference >= 0 ? "+" : ""}
          {euro(difference)}
        </span>
      </div>
    </div>
  );
}

function SummaryCard({
  label,
  value,
  icon,
  negative = false,
  emphasis = false,
}: {
  label: string;
  value: string;
  icon: React.ReactNode;
  negative?: boolean;
  emphasis?: boolean;
}) {
  return (
    <div
      className={`rounded-2xl border p-5 shadow-sm transition ${
        emphasis
          ? negative
            ? "border-red-200 bg-red-50/70 dark:border-red-900/50 dark:bg-red-950/20"
            : "border-zinc-300 bg-zinc-100/80 dark:border-zinc-700 dark:bg-zinc-800/80"
          : "border-zinc-200 bg-white dark:border-zinc-800 dark:bg-zinc-900"
      }`}
    >
      <div className="mb-4 flex items-center justify-between">
        <span className="text-sm font-medium text-zinc-500">
          {label}
        </span>

        <div className="rounded-xl bg-zinc-100 p-2 text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">
          {icon}
        </div>
      </div>

      <div
        className={`text-2xl font-semibold tracking-tight ${
          negative
            ? "text-red-600"
            : "text-zinc-950 dark:text-white"
        }`}
      >
        {value}
      </div>
    </div>
  );
}

function StatusMetric({
  label,
  value,
  detail,
  percentage,
  negative = false,
}: {
  label: string;
  value: string;
  detail: string;
  percentage: number;
  negative?: boolean;
}) {
  return (
    <div>
      <div className="flex items-end justify-between gap-3">
        <div>
          <p className="text-sm font-medium text-zinc-500">{label}</p>
          <p
            className={`mt-1 text-xl font-semibold ${
              negative
                ? "text-red-600"
                : "text-zinc-950 dark:text-white"
            }`}
          >
            {value}
          </p>
        </div>

        <span className="text-xs text-zinc-500">{detail}</span>
      </div>

      <div className="mt-3 h-2 overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-800">
        <div
          className={`h-full rounded-full transition-all ${
            negative ? "bg-red-500" : "bg-zinc-800 dark:bg-zinc-300"
          }`}
          style={{ width: `${Math.min(Math.max(percentage, 0), 100)}%` }}
        />
      </div>
    </div>
  );
}

function MiniStat({
  label,
  value,
}: {
  label: string;
  value: string;
}) {
  return (
    <div>
      <p className="text-xs text-zinc-500">{label}</p>
      <p className="mt-1 font-semibold">{value}</p>
    </div>
  );
}

function QuickAction({
  href,
  icon,
  title,
  description,
}: {
  href: string;
  icon: React.ReactNode;
  title: string;
  description: string;
}) {
  return (
    <Link
      href={href}
      className="group rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm transition hover:border-zinc-300 hover:shadow-md dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-zinc-700"
    >
      <div className="flex items-start gap-4">
        <div className="rounded-xl bg-zinc-100 p-2.5 text-zinc-700 transition group-hover:bg-zinc-200 dark:bg-zinc-800 dark:text-zinc-300 dark:group-hover:bg-zinc-700">
          {icon}
        </div>

        <div>
          <p className="text-sm font-semibold">{title}</p>
          <p className="mt-1 text-xs leading-5 text-zinc-500">
            {description}
          </p>
        </div>
      </div>
    </Link>
  );
}
