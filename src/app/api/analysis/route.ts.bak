import { NextResponse } from "next/server";
import { createClient } from "@/lib/supabase/server";

export async function GET(request: Request) {
  const supabase = await createClient();

  const {
    data: { user },
  } = await supabase.auth.getUser();

  if (!user) {
    return NextResponse.json(
      { error: "Non autenticato" },
      { status: 401 }
    );
  }

  const { searchParams } = new URL(request.url);
  const period = searchParams.get("period") ?? "12";

  const { data: plans, error: plansError } = await supabase
    .from("monthly_plans")
    .select(
      "month, expected_income, savings_goal, planned_fixed_expenses, actual_income, actual_expenses, actual_savings, is_closed"
    )
    .eq("user_id", user.id)
    .order("month", { ascending: true });

  if (plansError) {
    return NextResponse.json(
      { error: plansError.message },
      { status: 500 }
    );
  }

  let filteredPlans = plans ?? [];

  if (period !== "all") {
    const months = Number(period);

    if ([6, 12].includes(months)) {
      filteredPlans = filteredPlans.slice(-months);
    }
  }

  const monthsWithBudgets = await Promise.all(
    filteredPlans.map(async (plan) => {
      const { data: budgets, error } = await supabase
        .from("budgets")
        .select("category, planned_amount")
        .eq("user_id", user.id)
        .eq("month", plan.month)
        .order("category");

      if (error) {
        throw new Error(error.message);
      }

      const plannedVariableExpenses = (budgets ?? []).reduce(
        (sum, budget) =>
          sum + Number(budget.planned_amount ?? 0),
        0
      );

      const plannedFixedExpenses =
        Number(plan.planned_fixed_expenses ?? 0);

      const plannedExpenses =
        plannedFixedExpenses + plannedVariableExpenses;

      const plannedIncome =
        Number(plan.expected_income ?? 0);

      const plannedSavings =
        Number(plan.savings_goal ?? 0);

      const isClosed = Boolean(plan.is_closed);

      const actualIncome =
        Number(plan.actual_income ?? 0);

      const actualExpenses =
        Number(plan.actual_expenses ?? 0);

      const actualSavings =
        Number(plan.actual_savings ?? 0);

      return {
        month: plan.month,
        isClosed,

        plannedIncome,
        plannedFixedExpenses,
        plannedVariableExpenses,
        plannedExpenses,
        plannedSavings,

        actualIncome,
        actualExpenses,
        actualSavings,

        income: isClosed
          ? actualIncome
          : plannedIncome,

        expenses: isClosed
          ? actualExpenses
          : plannedExpenses,

        savings: isClosed
          ? actualSavings
          : plannedSavings,

        budgets: (budgets ?? []).map((budget) => ({
          category: budget.category,
          plannedAmount: Number(
            budget.planned_amount ?? 0
          ),
        })),
      };
    })
  );

  const totalPlannedIncome = monthsWithBudgets.reduce(
    (sum, item) => sum + item.plannedIncome,
    0
  );

  const totalPlannedExpenses = monthsWithBudgets.reduce(
    (sum, item) => sum + item.plannedExpenses,
    0
  );

  const totalPlannedSavings = monthsWithBudgets.reduce(
    (sum, item) => sum + item.plannedSavings,
    0
  );

  const closedMonths = monthsWithBudgets.filter(
    (item) => item.isClosed
  );

  const totalActualIncome = closedMonths.reduce(
    (sum, item) => sum + item.actualIncome,
    0
  );

  const totalActualExpenses = closedMonths.reduce(
    (sum, item) => sum + item.actualExpenses,
    0
  );

  const totalActualSavings = closedMonths.reduce(
    (sum, item) => sum + item.actualSavings,
    0
  );

  const totalIncome = monthsWithBudgets.reduce(
    (sum, item) => sum + item.income,
    0
  );

  const totalExpenses = monthsWithBudgets.reduce(
    (sum, item) => sum + item.expenses,
    0
  );

  const totalSavings = monthsWithBudgets.reduce(
    (sum, item) => sum + item.savings,
    0
  );

  const monthCount = monthsWithBudgets.length;

  const averageIncome =
    monthCount > 0 ? totalIncome / monthCount : 0;

  const averageExpenses =
    monthCount > 0 ? totalExpenses / monthCount : 0;

  const averageSavings =
    monthCount > 0 ? totalSavings / monthCount : 0;

  const savingsRate =
    totalIncome > 0
      ? (totalSavings / totalIncome) * 100
      : 0;

  const plannedSavingsRate =
    totalPlannedIncome > 0
      ? (totalPlannedSavings / totalPlannedIncome) * 100
      : 0;

  const actualSavingsRate =
    totalActualIncome > 0
      ? (totalActualSavings / totalActualIncome) * 100
      : 0;

  const categoryTotals = new Map<string, number>();

  monthsWithBudgets.forEach((month) => {
    month.budgets.forEach((budget) => {
      const current =
        categoryTotals.get(budget.category) ?? 0;

      categoryTotals.set(
        budget.category,
        current + budget.plannedAmount
      );
    });
  });

  const categories = Array.from(categoryTotals.entries())
    .map(([category, amount]) => ({
      category,
      amount,
      percentage:
        totalPlannedExpenses > 0
          ? (amount / totalPlannedExpenses) * 100
          : 0,
    }))
    .sort((a, b) => b.amount - a.amount);

  const latest = monthsWithBudgets.at(-1) ?? null;
  const previous =
    monthsWithBudgets.length > 1
      ? monthsWithBudgets.at(-2)
      : null;

  const comparison = latest && previous
    ? {
        income:
          latest.income - previous.income,
        expenses:
          latest.expenses - previous.expenses,
        savings:
          latest.savings - previous.savings,
      }
    : null;

  return NextResponse.json({
    period,
    months: monthsWithBudgets,

    summary: {
      monthCount,

      totalIncome,
      totalExpenses,
      totalSavings,

      averageIncome,
      averageExpenses,
      averageSavings,

      savingsRate,

      totalPlannedIncome,
      totalPlannedExpenses,
      totalPlannedSavings,
      plannedSavingsRate,

      totalActualIncome,
      totalActualExpenses,
      totalActualSavings,
      actualSavingsRate,

      closedMonths: closedMonths.length,
    },

    categories,
    comparison,
  });
}
