"use client";

import { useCallback, useEffect, useMemo, useState } from "react";
import Link from "next/link";
import {
  ArrowDown,
  ArrowLeft,
  ArrowRight,
  ArrowUp,
  CalendarDays,
  TrendingDown,
  TrendingUp,
  Wallet,
} from "lucide-react";
import {
  CartesianGrid,
  Line,
  LineChart,
  ResponsiveContainer,
  Tooltip,
  XAxis,
  YAxis,
} from "recharts";

type Transaction = {
  id: string;
  account_id: string;
  date: string;
  description: string;
  amount: number;
  type: "income" | "expense";
  category: string;
  notes?: string | null;
};

type Recurring = {
  id: string;
  name: string;
  amount: number;
  type: "income" | "expense";
  day: number;
  category: string;
  active: boolean;
};

type ForecastDay = {
  date: string;
  actualBalance: number;
  forecastBalance: number;
  actualIncome: number;
  actualExpenses: number;
  recurringIncome: number;
  recurringExpenses: number;
};

type CalendarData = {
  month: string;
  transactions: Transaction[];
  recurring: Recurring[];
  startingBalance: number;
  summary: {
    actualIncome: number;
    actualExpenses: number;
    actualBalance: number;
    recurringIncome: number;
    recurringExpenses: number;
    futureRecurringIncome: number;
    futureRecurringExpenses: number;
    recurringBalance: number;
    variableBudget: number;
    remainingVariableBudget: number;
    projectedEndBalance: number;
  };
  forecastDays: ForecastDay[];
};

const months = [
  "Gennaio",
  "Febbraio",
  "Marzo",
  "Aprile",
  "Maggio",
  "Giugno",
  "Luglio",
  "Agosto",
  "Settembre",
  "Ottobre",
  "Novembre",
  "Dicembre",
];

function formatCurrency(value: number) {
  return new Intl.NumberFormat("it-IT", {
    style: "currency",
    currency: "EUR",
    maximumFractionDigits: 0,
  }).format(value);
}

function formatDate(date: string) {
  return new Intl.DateTimeFormat("it-IT", {
    day: "2-digit",
    month: "long",
  }).format(new Date(`${date}T12:00:00`));
}

export default function CalendarioPage() {
  const [currentDate, setCurrentDate] = useState(() => {
    const today = new Date();

    return new Date(
      today.getFullYear(),
      today.getMonth(),
      1
    );
  });
  const [data, setData] = useState<CalendarData | null>(null);
  const [selectedDate, setSelectedDate] = useState<string | null>(null);
  const [loading, setLoading] = useState(true);

  const monthKey = `${currentDate.getFullYear()}-${String(
    currentDate.getMonth() + 1
  ).padStart(2, "0")}`;

  const todayKey = (() => {
    const today = new Date();

    return `${today.getFullYear()}-${String(
      today.getMonth() + 1
    ).padStart(2, "0")}-${String(today.getDate()).padStart(2, "0")}`;
  })();

  const loadCalendar = useCallback(async () => {
    setLoading(true);

    try {
      const response = await fetch(`/api/calendar?month=${monthKey}`);

      if (!response.ok) {
        throw new Error("Errore caricamento calendario");
      }

      const result = await response.json();
      setData(result);
    } catch {
      setData(null);
    } finally {
      setLoading(false);
    }
  }, [monthKey]);

  useEffect(() => {
    // eslint-disable-next-line react-hooks/set-state-in-effect
    void loadCalendar();
  }, [loadCalendar]);

  const days = useMemo(() => {
    const year = currentDate.getFullYear();
    const month = currentDate.getMonth();

    const firstDay = new Date(year, month, 1);
    const lastDay = new Date(year, month + 1, 0);

    const mondayIndex = (firstDay.getDay() + 6) % 7;

    const result: Array<Date | null> = [];

    for (let i = 0; i < mondayIndex; i++) {
      result.push(null);
    }

    for (let day = 1; day <= lastDay.getDate(); day++) {
      result.push(new Date(year, month, day));
    }

    return result;
  }, [currentDate]);

  const transactionsByDay = useMemo(() => {
    const map: Record<string, Transaction[]> = {};

    data?.transactions.forEach((transaction) => {
      if (!map[transaction.date]) {
        map[transaction.date] = [];
      }

      map[transaction.date].push(transaction);
    });

    return map;
  }, [data]);

  const recurringByDay = useMemo(() => {
    const map: Record<number, Recurring[]> = {};

    data?.recurring.forEach((item) => {
      const maxDay = new Date(
        currentDate.getFullYear(),
        currentDate.getMonth() + 1,
        0
      ).getDate();

      const day = Math.min(item.day, maxDay);

      if (!map[day]) {
        map[day] = [];
      }

      map[day].push(item);
    });

    return map;
  }, [data, currentDate]);

  const selectedTransactions = selectedDate
    ? transactionsByDay[selectedDate] ?? []
    : [];

  const selectedRecurring = selectedDate
    ? recurringByDay[
        Number(selectedDate.slice(-2))
      ] ?? []
    : [];

  const selectedForecast = selectedDate
    ? data?.forecastDays.find((item) => item.date === selectedDate)
    : null;

  const chartData =
    data?.forecastDays.map((item) => ({
      giorno: item.date.slice(-2),
      reale: Math.round(item.actualBalance),
      previsto: Math.round(item.forecastBalance),
    })) ?? [];

  function previousMonth() {
    setCurrentDate(
      new Date(currentDate.getFullYear(), currentDate.getMonth() - 1, 1)
    );
    setSelectedDate(null);
  }

  function nextMonth() {
    setCurrentDate(
      new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 1)
    );
    setSelectedDate(null);
  }

  return (
    <main className="min-h-screen bg-zinc-50 px-6 py-8 lg:px-10">
      <div className="mx-auto max-w-7xl space-y-8">
        <header className="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
          <div>
            <div className="mb-2 flex items-center gap-2 text-sm font-medium text-zinc-500">
              <CalendarDays className="h-4 w-4" />
              Calendario finanziario
            </div>

            <h1 className="text-3xl font-semibold tracking-tight text-zinc-950">
              {months[currentDate.getMonth()]}{" "}
              {currentDate.getFullYear()}
            </h1>

            <p className="mt-2 text-sm text-zinc-500">
              Movimenti reali, ricorrenti e previsione del saldo.
            </p>
          </div>

          <div className="flex items-center rounded-xl border border-zinc-200 bg-white p-1 shadow-sm">
            <button
              onClick={previousMonth}
              className="rounded-lg p-2 text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900"
            >
              <ArrowLeft className="h-4 w-4" />
            </button>

            <button
              onClick={() => {
                const today = new Date();
                setCurrentDate(
                  new Date(today.getFullYear(), today.getMonth(), 1)
                );
              }}
              className="px-4 py-2 text-sm font-medium text-zinc-700 hover:text-zinc-950"
            >
              Oggi
            </button>

            <button
              onClick={nextMonth}
              className="rounded-lg p-2 text-zinc-500 hover:bg-zinc-100 hover:text-zinc-900"
            >
              <ArrowRight className="h-4 w-4" />
            </button>
          </div>
        </header>

        {loading ? (
          <div className="rounded-2xl border border-zinc-200 bg-white p-10 text-center text-sm text-zinc-500">
            Caricamento calendario...
          </div>
        ) : data ? (
          <>
            <section className="grid gap-4 md:grid-cols-2 xl:grid-cols-5">
              <SummaryCard
                label="Saldo iniziale"
                value={data.startingBalance}
                icon={<Wallet className="h-4 w-4" />}
              />

              <SummaryCard
                label="Entrate effettive"
                value={data.summary.actualIncome}
                icon={<ArrowUp className="h-4 w-4" />}
                positive
              />

              <SummaryCard
                label="Uscite effettive"
                value={data.summary.actualExpenses}
                icon={<ArrowDown className="h-4 w-4" />}
                negative
              />

              <SummaryCard
                label="Saldo attuale"
                value={data.summary.actualBalance}
                icon={<Wallet className="h-4 w-4" />}
              />

              <SummaryCard
                label="Previsione fine mese"
                value={data.summary.projectedEndBalance}
                icon={<TrendingUp className="h-4 w-4" />}
                positive={data.summary.projectedEndBalance >= 0}
                negative={data.summary.projectedEndBalance < 0}
              />
            </section>

            <section className="grid gap-6 xl:grid-cols-[1.7fr_1fr]">
              <div className="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm">
                <div className="mb-5">
                  <h2 className="font-semibold text-zinc-950">
                    Evoluzione del saldo
                  </h2>
                  <p className="mt-1 text-sm text-zinc-500">
                    Reale fino a oggi e previsto per i giorni successivi.
                  </p>
                </div>

                <div className="h-72">
                  <ResponsiveContainer width="100%" height="100%">
                    <LineChart data={chartData}>
                      <CartesianGrid
                        strokeDasharray="3 3"
                        vertical={false}
                      />

                      <XAxis
                        dataKey="giorno"
                        tickLine={false}
                        axisLine={false}
                        fontSize={12}
                      />

                      <YAxis
                        tickLine={false}
                        axisLine={false}
                        fontSize={12}
                        tickFormatter={(value) =>
                          `${Math.round(value / 100) * 100}€`
                        }
                      />

                      <Tooltip
                        formatter={(value, name) => [
                          formatCurrency(Number(value)),
                          name === "reale" ? "Saldo reale" : "Saldo previsto",
                        ]}
                        labelFormatter={(label) => `Giorno ${label}`}
                      />

                      <Line
                        type="monotone"
                        dataKey="reale"
                        name="reale"
                        strokeWidth={2.5}
                        dot={false}
                      />

                      <Line
                        type="monotone"
                        dataKey="previsto"
                        name="previsto"
                        strokeWidth={2}
                        strokeDasharray="5 5"
                        dot={false}
                      />
                    </LineChart>
                  </ResponsiveContainer>
                </div>
              </div>

              <div className="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm">
                <h2 className="font-semibold text-zinc-950">
                  Previsione mensile
                </h2>

                <p className="mt-1 text-sm text-zinc-500">
                  Cosa dovrebbe succedere se rispetti il piano.
                </p>

                <div className="mt-6 space-y-4">
                  <ForecastRow
                    label="Entrate ricorrenti"
                    value={data.summary.futureRecurringIncome}
                    positive
                  />

                  <ForecastRow
                    label="Uscite ricorrenti"
                    value={data.summary.futureRecurringExpenses}
                    negative
                  />

                  <ForecastRow
                    label="Budget variabili"
                    value={data.summary.variableBudget}
                    negative
                  />

                  <div className="rounded-xl border border-zinc-200 bg-zinc-50 p-4">
                    <div className="flex items-center justify-between">
                      <span className="text-sm font-medium text-zinc-700">
                        Saldo previsto a fine mese
                      </span>

                      <span
                        className={`text-xl font-semibold tracking-tight ${
                          data.summary.projectedEndBalance >= 0
                            ? "text-zinc-950"
                            : "text-red-600"
                        }`}
                      >
                        {formatCurrency(data.summary.projectedEndBalance)}
                      </span>
                    </div>

                    <p className="mt-1 text-xs text-zinc-500">
                      Dopo ricorrenti e budget variabili residui.
                    </p>
                  </div>

                  <div
                    className={`rounded-xl p-4 ${
                      data.summary.remainingVariableBudget < 0
                        ? "bg-red-50"
                        : "bg-zinc-50"
                    }`}
                  >
                    <div
                      className={`flex items-center gap-2 text-sm font-medium ${
                        data.summary.remainingVariableBudget < 0
                          ? "text-red-600"
                          : "text-zinc-700"
                      }`}
                    >
                      <TrendingDown className="h-4 w-4" />
                      Budget variabile residuo
                    </div>

                    <p
                      className={`mt-2 text-2xl font-semibold ${
                        data.summary.remainingVariableBudget < 0
                          ? "text-red-600"
                          : "text-zinc-950"
                      }`}
                    >
                      {formatCurrency(
                        data.summary.remainingVariableBudget
                      )}
                    </p>

                    {data.summary.remainingVariableBudget < 0 && (
                      <p className="mt-1 text-xs text-red-500">
                        Hai superato il budget variabile previsto.
                      </p>
                    )}
                  </div>
                </div>
              </div>
            </section>

            <section className="overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm">
              <div className="border-b border-zinc-100 px-6 py-5">
                <h2 className="font-semibold text-zinc-950">
                  Calendario
                </h2>

                <p className="mt-1 text-sm text-zinc-500">
                  Seleziona un giorno per vedere i dettagli.
                </p>
              </div>

              <div className="grid grid-cols-7 border-b border-zinc-100 bg-zinc-50">
                {["Lun", "Mar", "Mer", "Gio", "Ven", "Sab", "Dom"].map(
                  (day) => (
                    <div
                      key={day}
                      className="px-3 py-3 text-center text-xs font-medium uppercase tracking-wide text-zinc-400"
                    >
                      {day}
                    </div>
                  )
                )}
              </div>

              <div className="grid grid-cols-7">
                {days.map((day, index) => {
                  if (!day) {
                    return (
                      <div
                        key={`empty-${index}`}
                        className="min-h-32 border-b border-r border-zinc-100 bg-zinc-50/50"
                      />
                    );
                  }

                  const date = `${day.getFullYear()}-${String(
                    day.getMonth() + 1
                  ).padStart(2, "0")}-${String(day.getDate()).padStart(
                    2,
                    "0"
                  )}`;

                  const transactions = transactionsByDay[date] ?? [];

                  const recurring =
                    date >= todayKey
                      ? recurringByDay[day.getDate()] ?? []
                      : [];

                  const forecast = data.forecastDays.find(
                    (item) => item.date === date
                  );

                  const isSelected = selectedDate === date;
                  const isToday = date === todayKey;

                  return (
                    <button
                      key={date}
                      onClick={() => setSelectedDate(date)}
                      className={`min-h-32 border-b border-r border-zinc-100 p-3 text-left align-top transition ${
                        isSelected
                          ? "bg-zinc-100"
                          : isToday
                            ? "bg-zinc-50"
                            : "hover:bg-zinc-50"
                      }`}
                    >
                      <div className="flex items-center justify-between">
                        <span
                          className={`flex h-7 min-w-7 items-center justify-center rounded-full text-sm font-semibold ${
                            isToday
                              ? "bg-zinc-950 text-white"
                              : "text-zinc-900 dark:text-zinc-100"
                          }`}
                        >
                          {day.getDate()}
                        </span>

                        {forecast && (
                          <span
                            className={`text-[10px] font-medium ${
                              forecast.forecastBalance < 0
                                ? "text-red-500"
                                : "text-zinc-400"
                            }`}
                          >
                            {formatCurrency(forecast.forecastBalance)}
                          </span>
                        )}
                      </div>

                      <div className="mt-3 space-y-1">
                        {transactions.slice(0, 3).map((transaction) => (
                          <div
                            key={transaction.id}
                            className="flex items-center justify-between gap-2 text-xs"
                          >
                            <span className="truncate text-zinc-600">
                              {transaction.description}
                            </span>

                            <span
                              className={
                                transaction.type === "income"
                                  ? "font-medium text-emerald-600"
                                  : "font-medium text-red-600"
                              }
                            >
                              {transaction.type === "income" ? "+" : "-"}
                              {formatCurrency(transaction.amount)}
                            </span>
                          </div>
                        ))}

                        {recurring.slice(0, 2).map((item) => (
                          <div
                            key={`recurring-${item.id}`}
                            className="flex items-center justify-between gap-2 rounded-md border border-dashed border-zinc-200 px-1.5 py-0.5 text-xs"
                          >
                            <span className="truncate text-zinc-400">
                              {item.name}
                            </span>

                            <span className="font-medium text-zinc-400">
                              {item.type === "income" ? "+" : "-"}
                              {formatCurrency(item.amount)}
                            </span>
                          </div>
                        ))}

                        {transactions.length + recurring.length > 5 && (
                          <div className="pt-1 text-[10px] text-zinc-400">
                            +
                            {transactions.length +
                              recurring.length -
                              5}{" "}
                            altri
                          </div>
                        )}
                      </div>
                    </button>
                  );
                })}
              </div>
            </section>

            {selectedDate && (
              <section className="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm">
                <div className="mb-5 flex items-center justify-between">
                  <div>
                    <h2 className="font-semibold text-zinc-950">
                      {formatDate(selectedDate)}
                    </h2>

                    <p className="mt-1 text-sm text-zinc-500">
                      Movimenti registrati e operazioni previste
                    </p>
                  </div>

                  {selectedForecast && (
                    <div className="text-right">
                      <p className="text-xs text-zinc-400">
                        Saldo previsto
                      </p>
                      <p
                        className={`font-semibold ${
                          selectedForecast.forecastBalance < 0
                            ? "text-red-600"
                            : "text-zinc-950"
                        }`}
                      >
                        {formatCurrency(
                          selectedForecast.forecastBalance
                        )}
                      </p>
                    </div>
                  )}
                </div>

                <div className="space-y-2">
                  {selectedTransactions.map((transaction) => (
                    <div
                      key={transaction.id}
                      className="flex items-center justify-between rounded-xl bg-zinc-50 p-4"
                    >
                      <div>
                        <p className="text-sm font-medium text-zinc-900">
                          {transaction.description}
                        </p>
                        <p className="mt-1 text-xs text-zinc-500">
                          {transaction.category}
                        </p>
                      </div>

                      <span
                        className={`font-semibold ${
                          transaction.type === "income"
                            ? "text-emerald-600"
                            : "text-red-600"
                        }`}
                      >
                        {transaction.type === "income" ? "+" : "-"}
                        {formatCurrency(transaction.amount)}
                      </span>
                    </div>
                  ))}

                  {selectedRecurring.map((item) => (
                    <div
                      key={`detail-recurring-${item.id}`}
                      className="flex items-center justify-between rounded-xl border border-dashed border-zinc-200 p-4"
                    >
                      <div>
                        <p className="text-sm font-medium text-zinc-700">
                          {item.name}
                        </p>
                        <p className="mt-1 text-xs text-zinc-400">
                          Operazione ricorrente prevista
                        </p>
                      </div>

                      <span className="font-semibold text-zinc-500">
                        {item.type === "income" ? "+" : "-"}
                        {formatCurrency(item.amount)}
                      </span>
                    </div>
                  ))}

                  {!selectedTransactions.length &&
                    !selectedRecurring.length && (
                      <div className="rounded-xl bg-zinc-50 p-6 text-center text-sm text-zinc-500">
                        Nessun movimento o operazione prevista.
                      </div>
                    )}
                </div>

                <div className="mt-5 flex justify-end">
                  <Link
                    href="/movimenti"
                    className="rounded-xl border border-zinc-200 px-4 py-2.5 text-sm font-medium text-zinc-700 transition hover:bg-zinc-50"
                  >
                    Gestisci movimenti
                  </Link>
                </div>
              </section>
            )}
          </>
        ) : (
          <div className="rounded-2xl border border-red-200 bg-red-50 p-6 text-sm text-red-700">
            Impossibile caricare il calendario.
          </div>
        )}
      </div>
    </main>
  );
}

function SummaryCard({
  label,
  value,
  icon,
  positive,
  negative,
}: {
  label: string;
  value: number;
  icon: React.ReactNode;
  positive?: boolean;
  negative?: boolean;
}) {
  return (
    <div className="rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm">
      <div className="flex items-center justify-between">
        <span className="text-sm text-zinc-500">{label}</span>
        <span
          className={`${
            negative
              ? "text-red-500"
              : positive
                ? "text-emerald-500"
                : "text-zinc-400"
          }`}
        >
          {icon}
        </span>
      </div>

      <p
        className={`mt-3 text-2xl font-semibold ${
          negative ? "text-red-600" : "text-zinc-950"
        }`}
      >
        {formatCurrency(value)}
      </p>
    </div>
  );
}

function ForecastRow({
  label,
  value,
  positive,
  negative,
}: {
  label: string;
  value: number;
  positive?: boolean;
  negative?: boolean;
}) {
  return (
    <div className="flex items-center justify-between">
      <span className="text-sm text-zinc-500">{label}</span>

      <span
        className={`text-sm font-semibold ${
          negative
            ? "text-red-600"
            : positive
              ? "text-emerald-600"
              : "text-zinc-950"
        }`}
      >
        {positive ? "+" : negative ? "-" : ""}
        {formatCurrency(value)}
      </span>
    </div>
  );
}
